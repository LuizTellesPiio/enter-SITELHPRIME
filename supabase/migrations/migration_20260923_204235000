-- LH Prime — Evolução do módulo de orçamento (mesmo módulo de precificação já existente).
-- Apenas colunas novas, sem remover nada e sem tocar em outras tabelas.

-- Configurações: diagnóstico da obra, etapas do serviço, equipe,
-- mobilização mínima e desconto máximo permitido.
alter table public.pricing_settings
  add column if not exists diagnosis jsonb not null default '{}'::jsonb,
  add column if not exists service_steps jsonb not null default '[]'::jsonb,
  add column if not exists team jsonb not null default '{}'::jsonb,
  add column if not exists mobilization_minimum numeric,
  add column if not exists max_discount_percent numeric;

alter table public.pricing_settings
  drop constraint if exists pricing_settings_mobilization_minimum_check,
  add constraint pricing_settings_mobilization_minimum_check
    check (mobilization_minimum is null or mobilization_minimum >= 0);

alter table public.pricing_settings
  drop constraint if exists pricing_settings_max_discount_percent_check,
  add constraint pricing_settings_max_discount_percent_check
    check (max_discount_percent is null or (max_discount_percent >= 0 and max_discount_percent <= 100));

-- Orçamentos: status, serviço, área, planejado x realizado e fechamento.
alter table public.pricing_simulations
  add column if not exists status text not null default 'planejado',
  add column if not exists service_key text,
  add column if not exists area numeric,
  add column if not exists planned jsonb,
  add column if not exists actual jsonb,
  add column if not exists closed_at timestamptz;

alter table public.pricing_simulations
  drop constraint if exists pricing_simulations_status_check,
  add constraint pricing_simulations_status_check check (status in ('planejado', 'concluida'));

create index if not exists pricing_simulations_status_idx
  on public.pricing_simulations (user_id, status, created_at desc);