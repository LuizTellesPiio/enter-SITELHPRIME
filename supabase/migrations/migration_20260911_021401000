-- Cliente Premiado LH Prime — schema base

-- 1) profiles
create table if not exists public.profiles (
  id uuid primary key references auth.users (id) on delete cascade,
  role text not null default 'client',
  created_at timestamptz not null default now(),
  constraint profiles_role_check check (role in ('admin','client'))
);

alter table public.profiles enable row level security;

-- security definer evita recursao de RLS nas policies
create or replace function public.is_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.profiles
    where id = auth.uid() and role = 'admin'
  );
$$;

create policy "profiles_select_own" on public.profiles
  for select using (auth.uid() = id);

create policy "profiles_select_admin" on public.profiles
  for select using (public.is_admin());

create policy "profiles_update_own" on public.profiles
  for update using (auth.uid() = id) with check (auth.uid() = id);

-- 2) trigger: cria profile e torna o PRIMEIRO usuario admin
create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  insert into public.profiles (id, role)
  values (
    new.id,
    case when not exists (select 1 from public.profiles) then 'admin' else 'client' end
  )
  on conflict (id) do nothing;
  return new;
end;
$$;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function public.handle_new_user();

-- 3) prizes (configuracao autoritativa da distribuicao)
create table if not exists public.prizes (
  id text primary key,
  position integer not null default 0,
  name text not null,
  short_name text not null,
  enabled boolean not null default true,
  quantity integer not null default 0,
  granted integer not null default 0,
  weight numeric not null default 1,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint prizes_quantity_check check (quantity >= 0),
  constraint prizes_granted_check check (granted >= 0),
  constraint prizes_weight_check check (weight > 0)
);

alter table public.prizes enable row level security;

create policy "prizes_select_admin" on public.prizes
  for select using (public.is_admin());

-- 4) campaign_config (linha unica)
create table if not exists public.campaign_config (
  id boolean primary key default true,
  prizes_configured boolean not null default false,
  updated_at timestamptz not null default now(),
  constraint campaign_config_single_row check (id)
);

alter table public.campaign_config enable row level security;

create policy "campaign_config_select_admin" on public.campaign_config
  for select using (public.is_admin());

insert into public.campaign_config (id, prizes_configured)
values (true, false)
on conflict (id) do nothing;

-- 5) participations
create table if not exists public.participations (
  id uuid primary key default gen_random_uuid(),
  code text not null unique,
  customer_name text not null,
  customer_phone text not null,
  budget_reference text not null default '',
  status text not null default 'LIBERADO',
  created_at timestamptz not null default now(),
  released_at timestamptz,
  used_at timestamptz,
  result_prize_id text,
  result_prize_name_snapshot text,
  delivered_at timestamptz,
  cancelled_at timestamptz,
  utm_source text,
  admin_notes text not null default '',
  created_by uuid references public.profiles (id) on delete set null,
  constraint participations_status_check check (status in ('LIBERADO','PREMIADO','ENTREGUE','CANCELADO'))
);

create index if not exists participations_status_idx on public.participations (status);
create index if not exists participations_created_at_idx on public.participations (created_at desc);

alter table public.participations enable row level security;

create policy "participations_select_admin" on public.participations
  for select using (public.is_admin());

