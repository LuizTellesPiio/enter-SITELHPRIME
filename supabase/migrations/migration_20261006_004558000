-- 2) Scheduler nativo do banco: a cada 10 minutos chama a função de processamento
--    com o token de ciclo lido do próprio banco (nenhum segredo exposto).
select cron.unschedule(jobid) from cron.job where jobname = 'instagram-auto-publish';

select cron.schedule(
  'instagram-auto-publish',
  '*/10 * * * *',
  $job$
  select net.http_post(
    url := 'https://spb-t4n3l80n68t0ufp3.supabase.opentrust.net/functions/v1/instagram-scheduler-337d4a58ae3d',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'x-cycle-token', (select cycle_token::text from public.instagram_settings where id)
    ),
    body := '{}'::jsonb
  );
  $job$
);