create table if not exists public.pricing_settings (
  user_id uuid primary key references auth.users(id) on delete cascade,
  personal_costs jsonb not null default '{}'::jsonb,
  professional_costs jsonb not null default '{}'::jsonb,
  charges jsonb not null default '{}'::jsonb,
  capacity jsonb not null default '{}'::jsonb,
  profit_margin numeric not null default 30 check (profit_margin >= 0),
  premium_extra numeric not null default 20 check (premium_extra >= 0),
  updated_at timestamptz not null default now()
);

create table if not exists public.pricing_simulations (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  reference text not null default '',
  days numeric not null default 0 check (days >= 0),
  daily_rate numeric not null default 0 check (daily_rate >= 0),
  total numeric not null default 0 check (total >= 0),
  created_at timestamptz not null default now()
);

create index if not exists pricing_simulations_user_idx on public.pricing_simulations (user_id, created_at desc);

alter table public.pricing_settings enable row level security;
alter table public.pricing_simulations enable row level security;

create policy pricing_settings_owner_select on public.pricing_settings for select using (auth.uid() = user_id and is_admin());
create policy pricing_settings_owner_insert on public.pricing_settings for insert with check (auth.uid() = user_id and is_admin());
create policy pricing_settings_owner_update on public.pricing_settings for update using (auth.uid() = user_id and is_admin()) with check (auth.uid() = user_id and is_admin());
create policy pricing_settings_owner_delete on public.pricing_settings for delete using (auth.uid() = user_id and is_admin());

create policy pricing_simulations_owner_select on public.pricing_simulations for select using (auth.uid() = user_id and is_admin());
create policy pricing_simulations_owner_insert on public.pricing_simulations for insert with check (auth.uid() = user_id and is_admin());
create policy pricing_simulations_owner_delete on public.pricing_simulations for delete using (auth.uid() = user_id and is_admin());