-- LH PRIME — Portfólio dinâmico: remove o limite fixo de projetos (01–09 / 10–12).
-- Estrutura nova e independente (nenhuma tabela existente é alterada, renomeada
-- ou esvaziada). Os projetos iniciais 01–12 continuam existindo com os MESMOS
-- caminhos no Storage, agora gerados a partir do slug de cada projeto.

-- 1) Projetos do portfólio.
create table if not exists public.portfolio_projects (
  id uuid primary key default gen_random_uuid(),
  seq bigint generated by default as identity unique,
  title text not null,
  slug text not null unique,
  type text not null default 'antes-depois',
  category text,
  featured boolean not null default false,
  sort_order integer not null default 0,
  is_active boolean not null default true,
  before_path text,
  after_path text,
  video_path text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint portfolio_projects_type_check check (type in ('antes-depois', 'finalizado')),
  constraint portfolio_projects_slug_check check (slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$')
);

comment on table public.portfolio_projects is 'Portfólio LH Prime: projetos ilimitados de Antes e Depois e Finalizados.';
comment on column public.portfolio_projects.seq is 'Numero sequencial interno (rotulo visual "Projeto NN"); gerado automaticamente.';
comment on column public.portfolio_projects.slug is 'Chave de caminho no Storage, gerada automaticamente a partir do seq (ex.: projeto-13).';
comment on column public.portfolio_projects.type is 'antes-depois (arquivos antes.mp4/depois.mp4) ou finalizado (finalizado.mp4).';
comment on column public.portfolio_projects.before_path is 'Caminho do arquivo "antes" dentro do bucket portfolio-lhprime.';
comment on column public.portfolio_projects.after_path is 'Caminho do arquivo "depois" dentro do bucket portfolio-lhprime.';
comment on column public.portfolio_projects.video_path is 'Caminho do arquivo do projeto finalizado dentro do bucket portfolio-lhprime.';

-- 2) Identificador e caminho automaticos (nunca digitados pelo usuario).
create or replace function public.portfolio_project_default_slug()
returns trigger
language plpgsql
set search_path to 'public'
as $$
begin
  if new.slug is null or btrim(new.slug) = '' then
    new.slug := 'projeto-' || lpad(new.seq::text, 2, '0');
  end if;
  return new;
end;
$$;

create trigger portfolio_projects_default_slug
  before insert on public.portfolio_projects
  for each row execute function public.portfolio_project_default_slug();

create or replace function public.set_updated_at()
returns trigger
language plpgsql
set search_path to 'public'
as $$
begin
  new.updated_at := now();
  return new;
end;
$$;

create trigger portfolio_projects_touch_updated_at
  before update on public.portfolio_projects
  for each row execute function public.set_updated_at();

-- 3) Acesso somente de administradores.
alter table public.portfolio_projects enable row level security;

create policy portfolio_projects_admin_select on public.portfolio_projects
  for select using (public.is_admin());

create policy portfolio_projects_admin_insert on public.portfolio_projects
  for insert with check (public.is_admin());

create policy portfolio_projects_admin_update on public.portfolio_projects
  for update using (public.is_admin()) with check (public.is_admin());

create policy portfolio_projects_admin_delete on public.portfolio_projects
  for delete using (public.is_admin());

grant select, insert, update, delete on public.portfolio_projects to authenticated;
grant select, insert, update, delete on public.portfolio_projects to service_role;

