create table if not exists public.pricing_materials (
  id text primary key,
  name text not null,
  unit text not null default 'L',
  sort_order integer not null default 0,
  is_active boolean not null default true,
  created_at timestamptz not null default now()
);

create table if not exists public.pricing_service_materials (
  id uuid primary key default gen_random_uuid(),
  service_key text not null,
  material_id text not null references public.pricing_materials(id) on delete cascade,
  yield_m2_per_unit numeric,
  coats numeric,
  waste_percent numeric,
  package_size numeric,
  package_label text,
  price_per_package numeric,
  manual_packages numeric,
  sort_order integer not null default 0,
  updated_at timestamptz not null default now(),
  unique (service_key, material_id)
);

create index if not exists pricing_service_materials_service_idx on public.pricing_service_materials (service_key, sort_order);

alter table public.pricing_materials enable row level security;
alter table public.pricing_service_materials enable row level security;

create policy pricing_materials_admin_all on public.pricing_materials for all using (is_admin()) with check (is_admin());
create policy pricing_service_materials_admin_all on public.pricing_service_materials for all using (is_admin()) with check (is_admin());

alter table public.pricing_settings
  add column if not exists surfaces jsonb not null default '[]'::jsonb,
  add column if not exists service_profile text,
  add column if not exists m2_per_day numeric;

